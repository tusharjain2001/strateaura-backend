# ---------------------------------------------------------------- SMTP ----
# Option A — Google Workspace / Gmail (needs a 16-char App Password, NOT the
# normal account password; 2-Step Verification must be on for the account).
SMTP_SERVICE=gmail
SMTP_USER=training@strateaura.com
SMTP_PASS=your-16-char-app-password

# Option B — any other host (Zoho, Titan, Hostinger, Microsoft 365...).
# Delete SMTP_SERVICE above and use these instead.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=training@strateaura.com
# SMTP_PASS=your-mailbox-password

# --------------------------------------------------------------- SENDING --
# Address the user sees as the sender. Must be a mailbox the SMTP_USER above is
# allowed to send as, otherwise the provider will reject or spam-folder it.
MAIL_FROM_ADDRESS=training@strateaura.com
MAIL_FROM_NAME=StrateAura

# Internal inbox that receives every form submission.
NOTIFY_EMAIL=training@strateaura.com

# ----------------------------------------------------------------- SITE ---
# Used for the links inside the emails.
SITE_URL=https://strateaura.com

# ------------------------------------------------------ BOOK PREVIEW PDF ---
# The preview chapter is attached to the book-preview confirmation email and the
# "Download Preview Chapter" button points here. Defaults to this backend's own
# /api/book-preview/download route, which streams assets/<PREVIEW_CHAPTER_FILE>.
PREVIEW_CHAPTER_URL=https://strateaura-backend.vercel.app/api/book-preview/download
# Filename of the PDF inside assets/ (attached + served by the download route).
PREVIEW_CHAPTER_FILE=preview-chapter.pdf

# ---------------------------------------------------------- BROCHURE PDF ---
# The brochure is attached to the brochure confirmation email and the "Download
# Brochure" button points here. Defaults to this backend's own
# /api/brochure/download route, which streams assets/<BROCHURE_FILE>.
BROCHURE_URL=https://strateaura-backend.vercel.app/api/brochure/download
# Filename of the PDF inside assets/ (attached + served by the download route).
BROCHURE_FILE=veil-brochure.pdf

# Comma-separated origins allowed to call the API. Leave unset only in local dev.
ALLOWED_ORIGINS=http://localhost:5173,https://strateaura.com,https://www.strateaura.com

PORT=4000
